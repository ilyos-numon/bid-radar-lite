# 운영(Cloud Run) 환경변수 전체 목록. 값은 비워 둔다 — 이 파일에 실제 값을 적어 커밋하지 않는다.
# 구역(# === 로 시작하는 줄)은 scripts/check-deploy.mjs 가 읽는다. 구역 이름을 바꾸지 않는다.
#   SECRET  Secret Manager 비밀 → Cloud Run secretKeyRef (비밀 이름 = 변수 이름, 버전 latest). deploy/gcp/setup.sh 가 만든다
#   ENV     Cloud Run 평문 env (deploy/gcp/service.yaml 의 env). 공개돼도 되는 값만
#   DEPLOY  앱이 읽지 않는다. deploy/gcp/setup.sh·deploy/gcp/apply-env.sh 입력과 GitHub Actions vars
#   UNUSED  운영에서는 비워 두는 변수 (로컬·테스트·예전 판 전용). 여기 적힌 것은 service.yaml 에 넣지 않는다

# === SECRET
# 로그인 쿠키 서명 비밀 (필수, 32바이트 이상 무작위)
APP_SECRET=
# 잡 호출 헤더 x-job-token 값 (필수). 앱이 하루 첫 방문 때 자기 잡 주소를 부를 때 쓴다
APP_JOB_TOKEN=
# Supabase service_role 키 (서버 전용)
SUPABASE_SERVICE_ROLE_KEY=
# 업무 데이터 Postgres 주소. app_worker 계정, 세션 풀러(5432) 전용. 직접 연결 주소는 IPv6 전용이라 Cloud Run 에서 안 됨. 트랜잭션 풀러(6543) 금지
APP_DB_URL=
# 토스페이먼츠 시크릿 키. 데모 운영은 테스트 키 test_sk_… (라이브 live_sk_… 전환은 별도)
TOSS_SECRET_KEY=
# Resend API 키
EMAIL_API_KEY=
# 공공데이터포털 나라장터 일반 인증키(Decoding). APP_SHARED_KEYS=1 일 때 공용 키
NARA_API_KEY=
# OpenAI 호환 LLM API 키. APP_SHARED_KEYS=1 일 때 공용 키
LLM_API_KEY=
# 기업마당 지원사업 API 키. APP_SHARED_KEYS=1 일 때 공용 키
SUPPORT_API_KEY=
# Cloudflare Turnstile 서버 검증 비밀 키. TURNSTILE_SITE_KEY 와 둘 다 있어야 가입 봇 확인이 켜진다 (쓰지 않으면 아무 문자열)
TURNSTILE_SECRET_KEY=

# === ENV
# 공개 주소 (https://<도메인>, <도메인> = Cloud Run 서비스 URL 호스트 …run.app). 메일 링크·폼 출처 검사·첫 방문 잡 호출 기준. 비우면 apply-env.sh 가 https://<서비스>-<PROJECT_NUMBER>.<리전>.run.app 로 채운다
APP_BASE_URL=
# Cloud Run 앞 프록시 홉 수. Cloud Run 은 1
APP_TRUST_PROXY=
# HTTPS 전용 쿠키. 1
APP_COOKIE_SECURE=
# 로그 양 (debug·info·warn·error·silent). info
APP_LOG_LEVEL=
# 이 인스턴스에서 상주 워커를 돌릴지. 운영은 0 (인스턴스 0 까지 줄고, 상주 워커·예약 실행 없음)
APP_WORKER=
# 1 이면 예약 실행 없음 모드: 하루 첫 방문이 공고 수집·데모 초기화를 시작하고 화면에 ? 안내가 붙는다. 운영은 1
APP_SCHEDULER_OFF=
# 회사별 무료 공고 가져오기 횟수 (0 = 무제한, 유료 구독은 항상 무제한). 기본 5
APP_FREE_COLLECTS=
# 첫 방문 수집 요청 하나가 쓰는 최대 시간(ms). 남은 회사는 다음 방문이 이어 간다. 기본 240000 (Cloud Run 300초 안)
APP_DAY_START_MAX_MS=
# 첫 방문 요청이 수집 시작(자기 잡 주소 호출) 수락을 기다리는 시간(ms). 기본 1500
APP_DAY_START_KICK_WAIT_MS=
# 진행 중 표시의 유효 시간(ms). 지나면 다음 방문이 다시 시작한다. 기본 600000
APP_DAY_START_CLAIM_TTL_MS=
# 데모 로그인이 그날 첫 초기화 완료를 기다리는 시간(ms). 기본 20000
APP_DAY_START_RESET_WAIT_MS=
# 워커 대기열 확인 간격(ms). 기본 5000
APP_WORKER_POLL_MS=
# 워커 동시 처리 회사 수. 기본 2
APP_WORKER_CONCURRENCY=
# 회사 하나 작업 시간 제한(ms). 기본 300000
APP_JOB_TIMEOUT_MS=
# ?wait=1 잡 요청(수동 호출) 안에서 대기열을 비우는 최대 시간(ms). 기본 240000 (Cloud Run 300초 안)
APP_JOB_WAIT_MS=
# 앱 하나가 여는 최대 DB 연결 수. 기본 10
APP_DB_POOL=
# 만들 수 있는 회사 수 상한. 기본 50
APP_MAX_WORKSPACES=
# 동시에 열어 두는 회사 수. 기본 20
APP_RUNTIME_CACHE=
# open · code · closed. 기본 open
APP_SIGNUP_MODE=
# APP_SIGNUP_MODE=code 일 때 가입 코드 (공개 가입이면 비움)
APP_SIGNUP_CODE=
# 1 이면 회사 키가 없을 때 위 NARA/LLM/SUPPORT 키를 공용으로 씀
APP_SHARED_KEYS=
# 외부 응답 최대 바이트. 기본 5242880
APP_FETCH_MAX_BYTES=
# Supabase 프로젝트 주소 (https://<project-ref>.supabase.co). 있으면 가입 모드
SUPABASE_URL=
# Supabase anon(공개) 키
SUPABASE_ANON_KEY=
# 나라장터 API 설정 (비우면 README 의 기본값)
NARA_API_BASE=
NARA_BID_OPERATION=
NARA_ROWS=
NARA_MAX_PAGES=
NARA_BACKFILL_MAX_DAYS=
NARA_RETRY=
NARA_PRESTD_BASE=
NARA_SCSBID_BASE=
NARA_AWARD_OPERATION=
# LLM API 주소(/v1 까지)·모델·제한 시간
LLM_API_BASE=
LLM_MODEL=
LLM_TIMEOUT_MS=
# 기업마당 지원사업 API 주소
SUPPORT_API_BASE=
# 토스페이먼츠 클라이언트 키 (브라우저 SDK). 데모 운영은 테스트 키 test_ck_…. 비면 카드 등록 버튼 비활성
TOSS_CLIENT_KEY=
# 토스 API 주소. 기본 https://api.tosspayments.com
TOSS_API_BASE=
# 무료 체험 일수. 기본 14
APP_TRIAL_DAYS=
# 결제 실패 재시도 간격(일, 쉼표). 기본 1,3,7
APP_BILLING_RETRY_DAYS=
# 이메일 API 주소. 기본 https://api.resend.com
EMAIL_API_BASE=
# 보내는 주소 (입찰 레이더 <alerts@<도메인>>). Resend 에서 인증한 도메인
EMAIL_FROM=
# 현재 약관·개인정보처리방침 버전 (바꾸면 로그인 뒤 재동의)
LEGAL_TERMS_VERSION=
LEGAL_PRIVACY_VERSION=
# 사업자 정보 (푸터·약관). 비면 각 항목 "미설정"
BUSINESS_NAME=
BUSINESS_REP=
BUSINESS_REG_NO=
BUSINESS_MAIL_ORDER_NO=
BUSINESS_ADDRESS=
BUSINESS_EMAIL=
BUSINESS_PHONE=
PRIVACY_OFFICER=
# 1 이면 데모 켜짐 (첫 화면 "데모로 둘러보기"·/demo/login·/api/jobs/demo-reset). 비면 꺼짐
APP_DEMO=
# 데모 계정 이메일 도메인. 기본 demo.example.com
APP_DEMO_EMAIL_DOMAIN=
# /admin 을 볼 수 있는 이메일 (쉼표, 대소문자 무시). 비면 아무도 못 봄
APP_PLATFORM_ADMIN_EMAILS=
# Cloudflare Turnstile 사이트 키 (공개). 비면 가입 봇 확인 꺼짐
TURNSTILE_SITE_KEY=
# Turnstile 검증 주소. 기본 https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_VERIFY_URL=
# KST 하루 예산 (0 = 무제한). 기본 200·200·50·500
APP_DAILY_MAX_EMAIL=
APP_DAILY_MAX_LLM=
APP_DAILY_MAX_SIGNUP=
APP_DAILY_MAX_DEMO_LOGIN=
# 속도 규칙 배수. 기본 1
APP_RATE_SCALE=
# 요청 본문 상한(바이트). 기본 262144
APP_BODY_LIMIT_BYTES=
# 요청 처리 상한(ms, 잡·웹훅 제외). 기본 30000
APP_REQUEST_TIMEOUT_MS=

# === DEPLOY
# GCP 프로젝트 ID (apply-env.sh 필수)
GCP_PROJECT_ID=
# 리전. 비우면 asia-northeast3
GCP_REGION=
# Supabase Session pooler 주소 (postgres 계정, …pooler.supabase.com:5432). apply-env.sh 가 마이그레이션·app_worker 비밀번호 설정에 쓴다. Direct 주소는 IPv6 전용이라 안 됨
SUPABASE_POOLER_URL=
# WIF 프로바이더 전체 이름 (projects/<번호>/locations/global/workloadIdentityPools/github-pool/providers/github-provider). setup.sh 가 출력
GCP_WIF_PROVIDER=
# 배포용 서비스 계정 이메일 (bid-radar-deploy@<PROJECT_ID>.iam.gserviceaccount.com). setup.sh 가 출력
GCP_DEPLOY_SA=
# Cloud Run 서비스 이름. bid-radar-lite
CLOUD_RUN_SERVICE=
# Artifact Registry 저장소 이름. bid-radar
ARTIFACT_REPO=
# WIF 조건에 넣을 GitHub 저장소 (<owner>/<repo>). setup.sh 입력 전용
GITHUB_REPO=

# === UNUSED
# Cloud Run 이 containerPort(8820)로 정한다
APP_PORT=
# 기존 모드(PGlite) 전용
APP_DATA_DIR=
# 테스트 전용 (가짜 현재 시각)
APP_FAKE_NOW=
# 테스트 전용 (localhost 모의 서버 허용). 운영에서 비워야 내부망 차단이 켜진다
APP_FETCH_ALLOW_HOSTS=
# 로컬 n8n 전용 (운영은 n8n 없이 하루 첫 방문이 앱 자신의 잡 주소를 부른다)
APP_BASE_URL_FOR_N8N=
# 기존 모드 기본 알림 주소 (가입 모드는 회사별 알림 설정)
NOTIFY_WEBHOOK_URL=
# 비우면 JWKS 공개키로 토큰 검증 (운영 권장)
SUPABASE_JWT_SECRET=
# 예전 판 변수 (설정돼 있으면 안내 후 시작하지 않음)
APP_DB_PATH=
APP_WS_DIR=
