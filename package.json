{
  "name": "bid-radar-lite",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "docker compose up -d n8n && npm run dev:app",
    "dev:app": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env app/server.mjs",
    "dev:down": "docker compose down",
    "test": "node --no-warnings=ExperimentalWarning --test \"tests/unit/**/*.test.mjs\"",
    "lint": "node scripts/lint.mjs",
    "build:workflow": "node scripts/build-workflow.mjs",
    "smoke:live": "node --env-file-if-exists=.env scripts/live-check.mjs",
    "record:nara": "node --env-file-if-exists=.env scripts/record-nara.mjs",
    "smoke:live:llm": "node --env-file-if-exists=.env scripts/live-check-llm.mjs",
    "smoke:live:support": "node --env-file-if-exists=.env scripts/live-check-support.mjs",
    "e2e": "node --no-warnings=ExperimentalWarning --test --test-concurrency=1 \"tests/e2e/**/*.test.mjs\"",
    "e2e:app": "node --no-warnings=ExperimentalWarning --test --test-concurrency=1 \"tests/e2e/app-*.test.mjs\"",
    "e2e:workflow": "node --test --test-concurrency=1 tests/e2e/smoke.test.mjs tests/e2e/workflow-daily.test.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "admin": "node --env-file-if-exists=.env scripts/platform-admin.mjs",
    "build:migration": "node scripts/build-migration.mjs",
    "migrate:sqlite": "node --env-file-if-exists=.env scripts/migrate-sqlite.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@hono/node-server": "^2.1.5",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.14",
    "hono-rate-limiter": "^0.5.4",
    "hwp.js": "^0.0.3",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.14",
    "p-retry": "^8.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "undici": "^8.12.3",
    "unpdf": "^2.0.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
